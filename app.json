{
  "expo": {
    "name": "Plate2Farm",
    "slug": "Plate2Farm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/main_logo.png",
    "userInterfaceStyle": "light",
    "scheme": "plate2farm",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Plate2Farm uses your location to show nearby farms and kitchens and measure distances."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/main_logo.png",
        "backgroundColor": "#F2F5F0"
      }
    },
    "web": {
      "favicon": "./assets/main_logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/main_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F2F5F0"
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Plate2Farm uses your location to show nearby farms and kitchens and measure distances."
        }
      ]
    ]
  }
}
